# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Opcional
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# --- Google Sheets (cuenta de servicio) ---
# ID = la parte entre /d/ y /edit en la URL de la hoja
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_SERVICE_ACCOUNT_EMAIL=bot-leads@tu-proyecto.iam.gserviceaccount.com
# Pega la private_key del JSON tal cual (con los \n), entre comillas dobles
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_TAB=Leads

# --- Asesores ---
# Números que reciben los avisos del embudo (calificado, visita agendada, post-visita...) (con código de país, separados por coma).
# Desde esos números pueden enviar comandos al bot: /embudo /etapa /lead /lista /pausar /activar /pausados
ADVISOR_NUMBERS=593999999999
# Horas que Sofía queda en silencio en un chat cuando un asesor escribe desde el número del bot
HUMAN_TAKEOVER_HOURS=12
# Opcional: avisar también los leads descalificados (true/false)
NOTIFY_DISQUALIFIED=false
# Opcional: horarios de visita que Sofía puede ofrecer
VISIT_SCHEDULE=Lunes a sábado de 9h00 a 17h00

# --- Servidor / comportamiento ---
PORT=3000
TZ=America/Guayaquil
LOG_LEVEL=info
MAX_HISTORY=10
# Horario (Ecuador) en el que se envían seguimientos y recordatorios automáticos
FOLLOWUP_HOURS=9-19
# Base de datos local del embudo
DB_PATH=./data/mone-gardens.db
MESSAGE_DEBOUNCE_MS=3500
# Opcional: limitar a números de prueba (separados por coma, con código de país)
ALLOWED_NUMBERS=
# Opcional: ruta a Chrome/Chromium si no usas el que descarga puppeteer
CHROME_PATH=
